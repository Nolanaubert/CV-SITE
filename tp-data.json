        {
          "id": "reseau-vlan",
          "title": "TP 1 — Project DMZ",
          "badge": "Réseau",
          "duration": "2h",
          "level": "Débutant",
          "tool": "Cisco Packet Tracer",
          "blocks": [
            {
              "type": "text",
              "content": "Un VLAN (Virtual Local Area Network) permet de segmenter logiquement un réseau physique en plusieurs réseaux distincts au niveau de la couche 2 du modèle OSI."
            },
            {
              "type": "note",
              "noteType": "info",
              "content": "Prérequis : avoir Cisco Packet Tracer 8+ installé."
            },
            {
              "type": "screenshot",
              "content": "assets/img/TOPOLOGIE DMZ.png",
              "caption": "CAPTURE - TOPOLOGIE DMZ "
            },
            {
              "type": "code",
              "content": "en\nconf t\nint ran f0/4-19, g0/1-2\nswitchport access vlan 999\nshut\nint ran f0/1-23, g0/1-2\nswitchport mode access\nswitchport port-security\nswitchport port-security mac-address sticky\nint f0/1\nswitchport access vlan 20\nint ran f0/2-3\nswitchport access vlan 10\nint f0/20\nswitchport access vlan 30\nint f0/21\nswitchport access vlan 40\nint ran f0/22-23\nswitchport access vlan 50\nend\nwr",
              "lang": "CISCO - IOS"
            },
            {
              "type": "note",
              "content": "en = Enable // Activé le mode développements\nshut = shutdown  \nconf t = configure Terminal // \nint ran = interface range // Configuration d'une interface\nwr = Write // Sauvegarder la configurations ",
              "noteType": "warn"
            }
          ]
        }
      ]
    },
